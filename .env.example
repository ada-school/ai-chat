# Copy to .env.local and fill in. Never commit real values.
# Anything prefixed with VITE_ is bundled into the browser build and is PUBLIC.

# --- Supabase (client) -------------------------------------------------------
# Project Settings → API. Leave empty to run in local mode (localStorage only).
# e.g. VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI provider (client) ----------------------------------------------------
# "mock" (default, hardcoded replies) or "gemini" (calls the `chat` Edge Function,
# falls back to mock on failure).
VITE_AI_PROVIDER=mock
# Simulated latency for the mock provider, in milliseconds.
VITE_MOCK_REPLY_DELAY_MS=700

# --- Server-side only (Supabase Edge Function secrets) -----------------------
# Do NOT prefix these with VITE_. Set them with:
#   supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=...
# They're listed here for documentation and for `supabase functions serve --env-file`.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
